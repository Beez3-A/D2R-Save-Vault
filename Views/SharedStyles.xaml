<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:D2RSaveVault.Views">

    <views:BoolToVisibilityConverter x:Key="BoolToVis" />
    <views:EnumToVisibilityConverter x:Key="EnumToVis" />
    <views:EnumToBoolConverter x:Key="EnumToBool" />

    <LinearGradientBrush x:Key="InfernalWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#303030" Offset="0" />
        <GradientStop Color="#343434" Offset="0.52" />
        <GradientStop Color="#303030" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InfernalSidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D3D3D" Offset="0" />
        <GradientStop Color="#393939" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InfernalCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#414141" Offset="0" />
        <GradientStop Color="#3D3D3D" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource InfernalCardBrush}" />
        <Setter Property="BorderBrush" Value="#505050" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
