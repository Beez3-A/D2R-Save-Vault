<UserControl x:Class="D2RSaveVault.Views.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:D2RSaveVault.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="640" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Options" Style="{StaticResource SectionTitle}" FontSize="26" />
            <TextBlock Style="{StaticResource SectionCaption}"
                       Text="Control startup, tray behaviour, D2R-bound backup timing, and appearance." />

            <Border Style="{StaticResource GlassCard}" Margin="0,4,0,14">
                <StackPanel>
                    <TextBlock Text="App behaviour" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Grid Margin="0,5">
                        <StackPanel Margin="0,0,90,0">
                            <TextBlock Text="Launch minimized to system tray" />
                            <TextBlock Text="Start quietly in the tray when D2R Save Vault is launched."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.LaunchMinimized, Mode=TwoWay}" Click="Save_OnChanged" />
                    </Grid>

                    <Grid Margin="0,10,0,5">
                        <StackPanel Margin="0,0,90,0">
                            <TextBlock Text="Minimize to system tray" />
                            <TextBlock Text="Using the minimize button hides the app to the tray."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}" Click="Save_OnChanged" />
                    </Grid>

                    <Grid Margin="0,10,0,5">
                        <StackPanel Margin="0,0,90,0">
                            <TextBlock Text="Keep running when closed" />
                            <TextBlock Text="Clicking X hides the app to the tray instead of exiting."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.MinimizeToTrayOnClose, Mode=TwoWay}" Click="Save_OnChanged" />
                    </Grid>

                    <Grid Margin="0,10,0,5">
                        <StackPanel Margin="0,0,90,0">
                            <TextBlock Text="Launch with Windows" />
                            <TextBlock Text="Start D2R Save Vault automatically when you sign in to Windows."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.LaunchWithWindows, Mode=TwoWay}"
                                         Click="LaunchWithWindows_OnChanged" />
                    </Grid>

                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Bind backups to D2R" />
                            <TextBlock Text="When enabled, automatic backups wait for Diablo II: Resurrected. They start when D2R opens and stop automatically when D2R exits. Save Vault itself stays running in the tray."
                                       FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.BindToD2R, Mode=TwoWay}" Click="Bind_OnChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Theme" />
                            <TextBlock Text="Choose the app appearance."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Width="160" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" SelectionChanged="Theme_OnChanged">
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="System" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <ui:Button Content="Reset app options to defaults" Margin="0,16,0,0"
                       HorizontalAlignment="Left" Icon="{ui:SymbolIcon ArrowReset24}"
                       Click="Reset_OnClick"
                       ToolTip="Restore tray, startup, D2R binding and theme options without changing backup folders or intervals" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
